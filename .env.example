# Environment variables. Placeholders only; never commit .env.local.
# All NEXT_PUBLIC_* values are public and baked in at build time (redeploy
# after changing). Restart `npm run dev` after edits. VERCEL_ENV is set by
# Vercel; do not set it.
#
#   Variable                              Local       Vercel Production   Vercel Preview
#   NEXT_PUBLIC_SUPABASE_URL              required    required            required
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  required    required            required
#   NEXT_PUBLIC_BASE_URL                  optional    optional            optional
#   NEXT_PUBLIC_BOOKING_URL               optional    optional            optional
#
# The build prerenders pages from Supabase, so `npm run build` needs the two
# Supabase values.


# ---- Local (.env.local) -----------------------------------------------------

# Supabase project (public content only; the publishable key is safe in the
# browser, never use the secret key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site origin as a full URL, for example https://veenailstudio.ca. Used for
# metadata, robots.txt and the sitemap. Production must set it; unset, robots
# and the sitemap point to http://localhost:3000.
NEXT_PUBLIC_BASE_URL=

# Booking app link. Default https://booking.veenailstudio.ca.
NEXT_PUBLIC_BOOKING_URL=


# ---- Vercel Production (set in Vercel, not here) ---------------------------

# NEXT_PUBLIC_SUPABASE_URL=<https://<project>.supabase.co>
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<Supabase > Project Settings > API keys>
